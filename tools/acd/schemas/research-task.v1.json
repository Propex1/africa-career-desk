{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://africacareerdesk.local/schemas/research-task.v1.json",
  "title": "ResearchTask",
  "type": "object",
  "required": ["schemaVersion", "taskId", "batchId", "batchRunId", "scope", "selectedEmployerIds", "createdAt", "instructionsPath", "employers"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "taskId": { "type": "string", "minLength": 1 },
    "batchId": { "type": "string", "minLength": 1 },
    "batchRunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$" },
    "scope": { "enum": ["pilot", "full_batch"] },
    "selectedEmployerIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "createdAt": { "type": "string", "format": "date-time" },
    "instructionsPath": { "type": "string", "minLength": 1 },
    "employers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/employer" } }
  },
  "$defs": {
    "employer": {
      "type": "object",
      "required": ["id", "displayName", "aliases", "inclusionRule", "manualReviewNotes", "sources"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "inclusionRule": { "type": "string" },
        "manualReviewNotes": { "type": "string" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "type", "required", "accessMethod", "expectedCoverage"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["official_careers", "official_ats", "linkedin_company", "linkedin_jobs", "other_verified", "google_query"] },
        "url": { "type": "string", "format": "uri" },
        "query": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "accessMethod": { "enum": ["http_json", "http_markdown", "web_page", "manual_review", "search"] },
        "expectedCoverage": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
